{
  "name": "fhsh-py-dojo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "test": "vitest",
    "format": "prettier --write --experimental-cli .vitepress/",
    "build:wasm": "wasm-pack build testcase-generator --target web --out-dir ../docs/public/wasm",
    "build:pyodide": "bash scripts/download-pyodide.sh",
    "build:pools": "npx tsx scripts/generate-pools.ts",
    "dev": "pnpm build:pools && pnpm build:wasm && pnpm build:pyodide && pnpm docs:dev",
    "build": "pnpm build:pools && pnpm build:wasm && pnpm build:pyodide && pnpm docs:build",
    "new-challenge": "npx tsx scripts/new-challenge.ts",
    "new-tutor": "npx tsx scripts/new-tutor.ts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.vitest.json --noEmit",
    "gen:keymaterial": "npx tsx scripts/gen-key-material.ts",
    "lint": "eslint .vitepress scripts --max-warnings 28 && prettier --check \"scripts/**/*.ts\" eslint.config.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.16",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/core": "^14.2.1",
    "codemirror": "^6.0.2",
    "idb": "^8.0.3",
    "pinia": "^3.0.4",
    "pyodide": "^0.29.3",
    "tailwindcss": "^4.2.1",
    "vitepress": "2.0.0-alpha.16",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "cytoscape": "^3.33.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-fcose": "^2.2.0",
    "dayjs": "^1.11.20",
    "debug": "^4.4.3",
    "dompurify": "^3.3.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.1.0",
    "katex": "^0.16.45",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.14.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.5"
