# 輔仁大學 EZProxy 設定
# 將此檔案複製為 .env 並填入你的帳號密碼
FJU_PROXY_USER=your_student_id
FJU_PROXY_PASS=your_password
FJU_PROXY_URL=https://ezproxy.lib.fju.edu.tw/login

# 輸出目錄（相對於專案根目錄）
OUTPUT_DIR=../../refs

# Semantic Scholar API Key（選填，無 key 有 rate limit）
SEMANTIC_SCHOLAR_API_KEY=

# 搜尋設定
SEARCH_YEAR_MIN=2024
SEARCH_YEAR_MAX=2026
